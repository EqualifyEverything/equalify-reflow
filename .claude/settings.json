{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$CLAUDE_PROJECT_DIR\" && uv run .claude/hooks/lint_modified.py'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
