# Equalify PDF Converter - Production Environment Variables Template
# Copy this file and fill in production values
# NEVER commit actual production credentials to version control

# ============================================================================
# AWS Configuration (Real AWS)
# ============================================================================
# Use AWS IAM roles in ECS instead of hardcoded credentials when possible
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL is not set - uses real AWS services

# ============================================================================
# S3 Bucket Configuration
# ============================================================================
S3_TEMP_BUCKET=equalify-pdf-temp
S3_RESULTS_BUCKET=equalify-pdf-results

# ============================================================================
# Redis Configuration
# ============================================================================
# Use AWS ElastiCache Redis endpoint in production
REDIS_URL=${REDIS_URL}
REDIS_QUEUE_PII=eq-pdf:queue:pii
REDIS_QUEUE_APPROVAL=eq-pdf:queue:approval
REDIS_QUEUE_PROCESSING=eq-pdf:queue:processing
REDIS_TIMEOUT_SET=eq-pdf:timeouts:approval
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ============================================================================
# Application Configuration
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================================================
# API Gateway Configuration
# ============================================================================
API_PORT=8080
API_HOST=0.0.0.0

# ============================================================================
# PII Detection Configuration
# ============================================================================
PII_DETECTION_ENABLED=true
PII_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# Processing Configuration
# ============================================================================
MAX_DOCUMENT_SIZE_MB=50
MAX_PAGES=40
PROCESSING_TIMEOUT=480

# ============================================================================
# Approval Workflow Configuration
# ============================================================================
# 7 days timeout for production
APPROVAL_TIMEOUT=604800
AUTO_APPROVE_HIGH_CONFIDENCE=false

# ============================================================================
# AI Processing Configuration (PydanticAI)
# ============================================================================
# Use AWS Secrets Manager or environment variables in ECS
OPENAI_API_KEY=${OPENAI_API_KEY}
AI_MODEL=gpt-4-turbo-preview
AI_CACHE_ENABLED=true

# ============================================================================
# Canvas LMS Integration (Production)
# ============================================================================
CANVAS_API_URL=${CANVAS_API_URL}
CANVAS_API_TOKEN=${CANVAS_API_TOKEN}

# ============================================================================
# Equalify Platform Integration (Production)
# ============================================================================
EQUALIFY_WEBHOOK_SECRET=${EQUALIFY_WEBHOOK_SECRET}
EQUALIFY_API_URL=${EQUALIFY_API_URL}

# ============================================================================
# Monitoring and Metrics
# ============================================================================
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOG_GROUP=/equalify-pdf-converter
METRICS_INTERVAL=60