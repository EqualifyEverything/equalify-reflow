# Equalify PDF Converter Demo UI - Environment Variables
# Copy this file to .env and fill in the values

# API URL - defaults to local development (port 8080)
VITE_API_URL=http://localhost:8080

# API Key for authentication
# Get this from your .env file in the project root (API_KEYS variable)
VITE_API_KEY=dev-key-1

# Optional: Grafana URL (if monitoring dashboard complete)
VITE_GRAFANA_URL=http://localhost:3000
