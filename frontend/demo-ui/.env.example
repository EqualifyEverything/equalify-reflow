# Equalify PDF Converter Demo UI - Environment Variables
# These are optional - the demo UI works without any .env file when served
# from the same origin as the API (which is the default setup).

# API URL - leave empty for same-origin (recommended)
# Only set this if running the frontend dev server separately
VITE_API_URL=

# Optional: Grafana URL for monitoring links
VITE_GRAFANA_URL=http://localhost:3000
