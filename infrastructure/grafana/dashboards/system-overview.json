{
  "id": null,
  "uid": "equalify-system-overview",
  "title": "Equalify PDF Converter - System Overview",
  "tags": ["equalify", "system", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 0,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "type": "stat",
      "title": "API Health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"equalify-api\"}",
          "legendFormat": "API Status",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN"}}},
            {"type": "value", "options": {"1": {"text": "UP"}}}
          ]
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "type": "stat",
      "title": "Redis Health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "redis_up",
          "legendFormat": "Redis Status",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN"}}},
            {"type": "value", "options": {"1": {"text": "UP"}}}
          ]
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "type": "stat",
      "title": "Total Queue Depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(queue_depth)",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 10, "color": "yellow"},
              {"value": 50, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "HTTP Error Rate (errors/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "{{status}} errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8},
      "type": "timeseries",
      "title": "HTTP Response Time (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ]
}
