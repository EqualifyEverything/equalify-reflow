# Terraform files to exclude from version control

# State files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform directory
.terraform/
.terraform.lock.hcl

# Secret variable files (non-secret terraform.tfvars is tracked)
secrets.auto.tfvars
!secrets.auto.tfvars.example

# Plan files
*.tfplan
tfplan
tfplan.*

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
