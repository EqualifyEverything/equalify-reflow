# Terraform files to exclude from version control

# State files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform directory
.terraform/
.terraform.lock.hcl

# Variable files with secrets
terraform.tfvars
*.auto.tfvars

# Plan files
*.tfplan

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
